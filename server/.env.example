# Zündung-Server: Beispielkonfiguration. Als server/.env kopieren und anpassen.
# Start: node --env-file-if-exists=server/.env server/server.js

# Adresse und Port, auf denen der Server lauscht.
# 127.0.0.1 passt hinter einem Reverse Proxy oder Cloudflare Tunnel; 0.0.0.0 öffnet ihn nach außen.
HOST=127.0.0.1
PORT=8377

# Öffentliche Adresse des Spiels (für die Links in der Reset-Mail), ohne Schrägstrich am Ende.
PUBLIC_URL=https://ignite.vounder.net

# Auf 1 setzen, wenn ein Proxy (Cloudflare, nginx) davor sitzt: Dann werden dessen Angaben zu
# Besucher-IP und HTTPS verwendet. Ohne Proxy auf 0 lassen.
TRUST_PROXY=1

# Ablageort der Datenbank (Standard: server/data).
# DATA_DIR=/var/lib/zuendung

# Mailversand für "Passwort vergessen". Ohne SMTP_HOST werden keine Mails verschickt;
# der Reset-Link steht dann nur im Protokoll des Servers.
# Port 465 = TLS von Anfang an, Port 587 = STARTTLS.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=465
# SMTP_USER=noreply@example.org
# SMTP_PASS=geheim
# MAIL_FROM=noreply@example.org
